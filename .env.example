# =============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =============================================
APP_PORT=8000
BASE_PATH=http://localhost:${APP_PORT}
APP_ENVIRONMENT=development

# =============================================
# CONFIGURACIÓN DE BASE DE DATOS (MySQL/MariaDB)
# =============================================
DB_HOST=db
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Alias para compatibilidad con docker-compose
MYSQL_DATABASE=${DB_NAME}
MYSQL_USER=${DB_USER}
MYSQL_PASSWORD=${DB_PASSWORD}
MYSQL_ROOT_PASSWORD=

# =============================================
# CONFIGURACIONES DE DESARROLLO
# =============================================
PMA_HOST=db
PMA_USER=${DB_USER}
PMA_PASSWORD=${DB_PASSWORD}
