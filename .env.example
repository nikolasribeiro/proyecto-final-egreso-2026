# ============================================
# CONFIGURACIONES GENERALES
# ============================================
APP_PORT=8000
BASE_PATH=http://localhost:${APP_PORT} # <- Dejar asi en modo desarrollo

# Base de datos de la aplicacion (MASTER - escritura)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Gestor de BD
PMA_HOST=db-master
PMA_USER=
PMA_PASSWORD=

# Variables visibles en PHP
APP_ENVIRONMENT=development

# ============================================
# ESTRATEGIA MASTER-SLAVE (replicacion + split read/write)
# ============================================
# Host de ESCRITURA: siempre el master.
DB_HOST=db-master
# Host de LECTURA: el slave (replica).
DB_SLAVE_HOST=db-slave
# Enruta SELECT al slave y INSERT/UPDATE/DELETE al master.
DB_READ_REPLICA_ENABLED=true
# Tras una escritura, espera a que el slave la aplique antes de responder.
# Garantiza "leer lo que escribi" a traves de requests (sin esto, una
# lectura posterior podria ir al slave y todavia no ver la fila).
DB_REPLICA_WAIT_AFTER_WRITE=true
DB_REPLICA_WAIT_TIMEOUT_MS=2000
# Usuario de replicacion (replicacion GTID). La password la genera el
# operador en el deploy si queda vacia.
MYSQL_REPLICATION_USER=repl
MYSQL_REPLICATION_PASSWORD=

# ============================================
# MONITOREO (Zabbix) — desarrollo y producción
# ============================================
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=cambiar_en_produccion
ZABBIX_DB_ROOT_PASSWORD=cambiar_en_produccion
ZABBIX_TZ=America/Montevideo
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-mysql:alpine-7.0.18
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-mysql:alpine-7.0.18
ZABBIX_AGENT_IMAGE=zabbix/zabbix-agent2:alpine-7.0.18
ZABBIX_DB_IMAGE=mysql:8.0.41
# URL pública del frontend de Zabbix (cómo lo ve el usuario final).
# CRÍTICO cuando Zabbix vive detrás de un reverse proxy en sub-path:
# si Zabbix no conoce su URL pública completa, emite redirects relativos
# que el navegador resuelve en bucles infinitos al cruzar auth/login.
ZABBIX_BASE_URL=http://localhost:${APP_PORT}/zabbix
