# Configuraciones Generales
APP_PORT=8000
BASE_PATH=http://localhost:${APP_PORT} # <- Dejar asi en modo desarrollo
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Configuraciones de desarrollo
PMA_HOST=db # <- Dejar como está
PMA_USER=
PMA_PASSWORD=

# Variables visibles en PHP
APP_ENVIRONMENT=development

# ============================================
# MONITOREO (Zabbix) — solo producción
# ============================================
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=cambiar_en_produccion
ZABBIX_DB_ROOT_PASSWORD=cambiar_en_produccion
ZABBIX_TZ=America/Montevideo
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-mysql:alpine-7.0.18
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-mysql:alpine-7.0.18
ZABBIX_AGENT_IMAGE=zabbix/zabbix-agent2:alpine-7.0.18
ZABBIX_DB_IMAGE=mysql:8.0.41
# URL pública del frontend de Zabbix (cómo lo ve el usuario final).
# CRÍTICO cuando Zabbix vive detrás de un reverse proxy en sub-path:
# si Zabbix no conoce su URL pública completa, emite redirects relativos
# que el navegador resuelve en bucles infinitos al cruzar auth/login.
ZABBIX_BASE_URL=http://localhost:${APP_PORT}/zabbix

# ============================================
# CONEXIÓN A LA BD (PHP → MariaDB)
# ============================================
# DB_HOST/DB_PORT son consumidos por src/Nucleo/BD.php.
# Defaults seguros: db:3306 (servicio `db` en docker-compose).
# DB_HOST=db
# DB_PORT=3306